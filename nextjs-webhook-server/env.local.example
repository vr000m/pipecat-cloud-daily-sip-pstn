PINLESS_HMAC_SECRET=your_hmac_secret

# Pipecat Cloud API keys for starting bot sessions
PIPECAT_CLOUD_API_KEY_PROD=your_production_api_key
PIPECAT_CLOUD_API_KEY_STAGING=your_staging_api_key

# Daily API keys for fetching phone configurations (optional)
# These are used by npm run update-phones to auto-fetch phone numbers
DAILY_API_KEY_PROD=your_daily_production_api_key
DAILY_API_KEY_STAGING=your_daily_staging_api_key

AGENT_NAME=my-first-agent
PORT=8000