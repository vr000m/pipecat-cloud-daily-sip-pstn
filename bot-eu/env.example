# Daily credentials
DAILY_API_KEY=
# only set if you are sending the call to QA/Staging
# DAILY_API_URL=https://api.staging.daily.co/v1

# Twilio credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Consider using US and EU tokens or 
# creating different env files/secrets with TWILIO_AUTH_TOKEN 
# TWILIO_AUTH_TOKEN_US=
# TWILIO_AUTH_TOKEN_EU=


# Service keys
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=

# Environment mode: "local" for development, "production" for cloud deployment
ENV=local
# ENV=production

# Local bot server URL (where bot.py runs)
LOCAL_SERVER_URL=http://localhost:7860

# Pipecat Cloud (only needed for production)
PIPECAT_API_KEY=
PIPECAT_AGENT_NAME=daily-twilio-sip-dial-in

# only set if you are sending the call to QA/Staging
# PIPECAT_HOSTNAME=staging.qa.pipecat.cloud