# Unified Webhook Server Environment Variables

# =============================================================================
# Pipecat Cloud Configuration
# =============================================================================

# Daily handler: Pipecat Cloud API key (for /api/dial endpoint)
PIPECAT_CLOUD_API_KEY=pk_prod_your_api_key_here
PIPECAT_CLOUD_API_KEY_STAGING=pk_staging_your_api_key_here

# Daily handler: Agent name deployed to Pipecat Cloud
AGENT_NAME=my-first-agent

# Twilio handler: Pipecat Cloud configuration (for /api/twilio/call endpoint)
PIPECAT_API_KEY=pk_prod_your_api_key_here
PIPECAT_AGENT_NAME=my-twilio-agent
PIPECAT_HOSTNAME=api.pipecat.daily.co  # Use staging.qa.pipecat.cloud for staging

# =============================================================================
# Daily Configuration
# =============================================================================

# HMAC secret for Daily pinless dial-in webhook validation (base64-encoded)
PINLESS_HMAC_SECRET=your_base64_encoded_secret_here

# Daily API key (required for local mode and Twilio handler)
DAILY_API_KEY=your_daily_api_key_here

# Daily API URL (optional, defaults to https://api.daily.co)
# Use https://api.staging.daily.co/v1 for staging
DAILY_API_URL=https://api.daily.co/v1

# =============================================================================
# Environment Settings
# =============================================================================

# Environment mode: "production" or "local"
# - production: Uses Pipecat Cloud API to start bots
# - local: Uses LOCAL_SERVER_URL to start bots
ENV=local

# Daily environment: "staging" or "production"
# Controls which Pipecat Cloud API endpoint to use for Daily handler
DAILY_ENV=production

# Server port
PORT=8080

# =============================================================================
# Local Development
# =============================================================================

# URL of local bot server (used when ENV=local)
# This is where bot-eu/bot.py listens for /start requests
LOCAL_SERVER_URL=http://localhost:7860
